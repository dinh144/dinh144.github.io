{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--browser",
        "chromium",
        "--executable-path",
        "/usr/bin/chromium"
      ]
    },
    "astro-docs": {
      "type": "http",
      "url": "https://mcp.docs.astro.build/mcp"
    },
    "ui-skills": {
      "type": "http",
      "url": "https://www.ui-skills.com/mcp"
    },
    "awwwards": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "awwwards-mcp@1.18.0",
        "-p",
        "playwright@1.64.0",
        "-p",
        "ffmpeg-static@5.3.0",
        "awwwards-mcp"
      ],
      "env": {
        "NODE_USE_ENV_PROXY": "1",
        "FFMPEG_BIN": "ffmpeg",
        "AWWWARDS_MCP_IMAGE_RETENTION_DAYS": "30"
      }
    }
  }
}
