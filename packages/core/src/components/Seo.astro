---
/**
 * <head> metadata: title, description, canonical, hreflang alternates, Open Graph, RSS.
 * Pass `alternates` only for locales the page really exists in.
 */
import { DEFAULT_LOCALE, LOCALES, type Locale } from '../i18n';
import { paths, switchLocale } from '../routes';
import { SITE } from '../site';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  /** Absolute or root-relative image URL; defaults to none. */
  image?: string;
  type?: 'website' | 'article';
  published?: Date;
  /** Locales this page exists in; defaults to all. */
  available?: Locale[];
  noindex?: boolean;
}

const {
  title,
  description = '',
  locale,
  image,
  type = 'website',
  published,
  available = [...LOCALES],
  noindex = false,
} = Astro.props;
const site = Astro.site ?? new URL(SITE.origin);
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site).href;
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
const imageUrl = image ? new URL(image, site).href : undefined;
const alternates = available.map((l) => ({ locale: l, href: new URL(switchLocale(pathname, l), site).href }));
const xDefault = alternates.find((a) => a.locale === DEFAULT_LOCALE);
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
{alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)}
{alternates.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} (${locale})`}
  href={new URL(paths.rss(locale), site).href}
/>
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale === 'vi' ? 'vi_VN' : 'en_GB'} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && <meta property="og:image:width" content="1200" />}
{imageUrl && <meta property="og:image:height" content="630" />}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{noindex && <meta name="robots" content="noindex" />}
<meta name="generator" content={Astro.generator} />
