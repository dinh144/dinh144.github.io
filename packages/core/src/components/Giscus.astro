---
/**
 * Giscus comments, mapped by post slug so every theme (and both languages)
 * share one discussion per post. Renders a short note until the repo/category ids are set.
 */
import { t, type Locale } from '../i18n';
import { SITE } from '../site';

interface Props {
  slug: string;
  locale: Locale;
  /** A giscus theme name or an absolute URL to a theme CSS file. */
  theme?: string;
}

const { slug, locale, theme = 'preferred_color_scheme' } = Astro.props;
const ready = Boolean(SITE.giscus.repoId && SITE.giscus.categoryId);
---

<section class="giscus-wrap" aria-label={t(locale, 'post.comments')}>
  {ready ? (
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={SITE.giscus.repo}
      data-repo-id={SITE.giscus.repoId}
      data-category={SITE.giscus.category}
      data-category-id={SITE.giscus.categoryId}
      data-mapping="specific"
      data-term={slug}
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme={theme}
      data-lang={locale}
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  ) : (
    <p class="giscus-pending">{t(locale, 'post.commentsPending')}</p>
  )}
</section>
