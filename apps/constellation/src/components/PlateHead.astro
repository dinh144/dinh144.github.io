---
/**
 * Header for index pages, set like a plate in a star atlas: the title and a short caption on the left,
 * the framed region of the sky on the right (above the title on phones).
 */
import type { Orientation, Rect, Sky } from '../lib/sky';
import SkyStage from './SkyStage.astro';

interface Props {
  title: string;
  caption?: string;
  sky?: Sky;
  frame?: Record<Orientation, Rect>;
  focus?: string[];
  only?: boolean;
  anchors?: 'all' | 'focus' | 'none';
  keepStatic?: boolean;
  draw?: boolean;
  lang?: string;
  /** Hide star labels (whole-sky plates stay an ambient chart; hover still names a star). */
  quiet?: boolean;
}
const { title, caption, sky, frame, focus, only, anchors = 'focus', keepStatic, draw, lang, quiet } = Astro.props;
---

<header class:list={['plate wrap', { 'plate--sky': sky && frame }]}>
  {sky && frame && (
    <SkyStage
      sky={sky}
      frame={frame}
      focus={quiet ? [] : focus}
      only={only}
      world="land"
      anchors={quiet && anchors === 'focus' ? 'none' : anchors}
      variant="band"
      keepStatic={keepStatic}
      draw={draw}
      class="plate-sky"
    />
  )}
  <div class="plate-copy">
    <slot name="before" />
    <h1 class="display plate-title" lang={lang}>
      {title}
    </h1>
    {caption && <p class="plate-caption">{caption}</p>}
    <slot />
  </div>
</header>
