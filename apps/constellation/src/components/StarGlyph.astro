---
/** Chart symbol per post type: article = four-point star, note = dot, link = ring. Shape, not only colour. */
interface Props {
  type: 'article' | 'note' | 'link' | 'series' | 'tag';
  size?: number;
}
const { type, size = 20 } = Astro.props;
---

<svg class={`glyph glyph--${type}`} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {type === 'article' && (
    <path d="M12 2.5c.6 5.2 3.3 8.9 9.5 9.5-6.2.6-8.9 4.3-9.5 9.5-.6-5.2-3.3-8.9-9.5-9.5 6.2-.6 8.9-4.3 9.5-9.5z" />
  )}
  {type === 'note' && <circle cx="12" cy="12" r="4.2" />}
  {type === 'link' && <circle cx="12" cy="12" r="5.6" fill="none" stroke-width="2" />}
  {type === 'series' && <path d="M3 17 9 8l6 6 6-9" fill="none" stroke-width="1.6" stroke-linecap="round" />}
  {type === 'tag' && <path d="M3 12h18" fill="none" stroke-width="1.4" stroke-dasharray="3 3" />}
</svg>
