---
/** One authored icon set: 24px grid, 1.6 stroke, round joins, currentColor. */
interface Props {
  name:
    | 'search'
    | 'moon'
    | 'sun'
    | 'sound'
    | 'sound-off'
    | 'book'
    | 'arrow-left'
    | 'arrow-right'
    | 'arrow-down'
    | 'external'
    | 'info';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg
  class={`icon icon-${name}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'search' && (
    <>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="M15.5 15.5 20 20" />
    </>
  )}
  {name === 'moon' && <path d="M19.5 14.6A7.8 7.8 0 1 1 9.4 4.5a6.3 6.3 0 0 0 10.1 10.1z" />}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.8v2.1M12 19.1v2.1M2.8 12h2.1M19.1 12h2.1M5.5 5.5 7 7M17 17l1.5 1.5M5.5 18.5 7 17M17 7l1.5-1.5" />
    </>
  )}
  {name === 'sound' && (
    <>
      <path d="M4.5 9.5v5h3.6l4.4 3.6V5.9L8.1 9.5H4.5z" />
      <path d="M15.6 9.2a4 4 0 0 1 0 5.6M18 6.8a7.4 7.4 0 0 1 0 10.4" />
    </>
  )}
  {name === 'sound-off' && (
    <>
      <path d="M4.5 9.5v5h3.6l4.4 3.6V5.9L8.1 9.5H4.5z" />
      <path d="m16 10 4 4M20 10l-4 4" />
    </>
  )}
  {name === 'book' && (
    <>
      <path d="M12 6.5c-1.8-1.3-4.4-1.9-7.5-1.8v13c3.1-.1 5.7.5 7.5 1.8 1.8-1.3 4.4-1.9 7.5-1.8v-13c-3.1-.1-5.7.5-7.5 1.8z" />
      <path d="M12 6.5v13" />
    </>
  )}
  {name === 'arrow-left' && <path d="M19 12H5.5M11 6l-6 6 6 6" />}
  {name === 'arrow-right' && <path d="M5 12h13.5M13 6l6 6-6 6" />}
  {name === 'arrow-down' && <path d="M12 5v13.5M6 13l6 6 6-6" />}
  {name === 'external' && <path d="M8 6.5h9.5V16M17.5 6.5 6.5 17.5" />}
  {name === 'info' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 11v5.2M12 7.8v.1" />
    </>
  )}
</svg>
