---
import { t, type Locale } from '@blog/core/i18n';
import { getPosts, tagsOf } from '@blog/core/posts';
import { localePaths, paths } from '@blog/core/routes';
import PlateHead from '../../../components/PlateHead.astro';
import Layout from '../../../layouts/Layout.astro';
import { frameFor, getSky } from '../../../lib/sky';

export const getStaticPaths = () => localePaths();

const { locale } = Astro.props as { locale: Locale };
const tags = tagsOf(await getPosts(locale));
const sky = await getSky(locale);
const vi = locale === 'vi';
const frame = frameFor(sky, { aspect: { land: 1.55, port: 1.5 } });
const caption = vi
  ? 'Mỗi chủ đề là một vùng trời; bài chung chủ đề được nối bằng nét đứt.'
  : 'Each topic is a region of the sky; posts that share one are joined by a dashed line.';
---

<Layout locale={locale} title={t(locale, 'tags.title')} page="tags">
  <PlateHead title={t(locale, 'tags.title')} caption={caption} sky={sky} frame={frame} anchors="all" />
  <section class="catalogue wrap" aria-label={t(locale, 'tags.title')}>
    <ul class="tag-index">
      {tags.map((tag) => (
        <li>
          <a href={paths.tag(locale, tag.name)}>
            <span class="tag-name">#{tag.name}</span>
            <span class="tag-count">
              {tag.count} {vi ? 'bài' : tag.count === 1 ? 'post' : 'posts'}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
