---
import { formatDate, t, type Locale } from '@blog/core/i18n';
import { getSeriesList } from '@blog/core/posts';
import { localePaths, paths } from '@blog/core/routes';
import PageHead from '../../../components/PageHead.astro';
import Layout from '../../../layouts/Layout.astro';
import { bar } from '../../../lib/copy';

export const getStaticPaths = () => localePaths();

const { locale } = Astro.props as { locale: Locale };
const list = await getSeriesList(locale);
---

<Layout locale={locale} title={t(locale, 'nav.series')} kind="list">
  <PageHead title={t(locale, 'nav.series')} count={String(list.length)} />
  <div class="frame">
    {list.length ? (
      <ol class="score" data-score>
        {list.map((series, i) => (
          <li class="row" data-type="article">
            <span class="row-no" aria-hidden="true">
              {bar(list.length - i)}
            </span>
            <div class="row-main">
              <h2 class="row-title" transition:name={`series-${series.id}`}>
                <a href={paths.series(locale, series.id)} data-kin>
                  {series.title}
                </a>
              </h2>
              {series.description && <p class="row-dek">{series.description}</p>}
            </div>
            <p class="row-meta">
              <span class="row-type">{t(locale, 'series.parts', { n: series.parts.length })}</span>
              <time datetime={series.latest.toISOString()}>{formatDate(series.latest, locale, 'numeric')}</time>
            </p>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty">{t(locale, 'series.empty')}</p>
    )}
  </div>
</Layout>
