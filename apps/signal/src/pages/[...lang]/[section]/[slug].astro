---
import Giscus from '@blog/core/components/Giscus.astro';
import { formatDate, otherLocale, t, type Locale } from '@blog/core/i18n';
import { getPosts, getSeriesFor, neighbours, type Post } from '@blog/core/posts';
import { paths, postPaths } from '@blog/core/routes';
import { render } from 'astro:content';
import Opener from '../../../components/Opener.astro';
import TreeToc from '../../../components/TreeToc.astro';
import Layout from '../../../layouts/Layout.astro';
import { c } from '../../../lib/copy';

export const getStaticPaths = () => postPaths();

const { locale, post } = Astro.props as { locale: Locale; post: Post };
const { data } = post;
const { Content, headings } = await render(post.entry);
const series = await getSeriesFor(post);
const { prev, next } = neighbours(await getPosts(locale), post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const other = otherLocale(locale);
const hasOther = post.available.includes(other);
const lang = post.contentLocale;
const host = data.type === 'link' && data.link ? new URL(data.link).hostname.replace(/^www\./, '') : undefined;
const typeLabel =
  data.series && series
    ? `${t(locale, 'type.series')} · ${t(locale, 'post.part', { n: data.series.part, total: series.parts.length })}`
    : t(locale, `type.${data.type}`);
---

<Layout
  locale={locale}
  title={data.title}
  description={data.description}
  image={paths.og(locale, post.slug)}
  type="article"
  published={data.date}
  available={post.available}
  reading
>
  <article>
    <Opener title={data.title} seedKey={post.slug} dek={data.description || undefined} lang={lang}>
      <p class="meta" lang={locale}>
        <span class="type-chip" data-type={data.type}>
          [{typeLabel}]
        </span>
        <time datetime={data.date.toISOString()}>{formatDate(data.date, locale, 'numeric')}</time>
        {data.updated && (
          <span>{t(locale, 'post.updated', { date: formatDate(data.updated, locale, 'numeric') })}</span>
        )}
        <span>{t(locale, 'post.minutes', { n: post.minutes })}</span>
        {hasOther && (
          <a href={paths.post({ ...post, locale: other })} hreflang={other} lang={other}>
            {t(locale, 'post.readIn')}
          </a>
        )}
      </p>
    </Opener>

    <div class="article-body wrap">
      {toc.length > 1 && <TreeToc locale={locale} headings={toc} />}
      <div class="prose" lang={lang} data-prose>
        {post.fallback && (
          <p class="notice" lang={locale}>
            <span class="tag">{c(locale, 'notice.warn')}</span>
            <span>{t(locale, 'post.fallback')}</span>
          </p>
        )}
        {data.aiDraft && (
          <p class="notice" lang={locale}>
            <span class="tag">{c(locale, 'notice.ai')}</span>
            <span>{t(locale, 'post.aiDraft')}</span>
          </p>
        )}
        {series && (
          <nav class="series-box" aria-label={series.title} lang={locale}>
            <div class="head">
              <a href={paths.series(locale, series.id)}>{series.title}</a>
              <span>{t(locale, 'series.parts', { n: series.parts.length })}</span>
            </div>
            <ol>
              {series.parts.map((part) => (
                <li>
                  {part.slug === post.slug ? (
                    <span aria-current="page">{part.data.title}</span>
                  ) : (
                    <a href={paths.post(part)}>{part.data.title}</a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )}
        {data.type === 'link' && data.link && (
          <p>
            <a class="visit" href={data.link} rel="noopener">
              {t(locale, 'post.visitLink')} <span class="host">↗ {host}</span>
            </a>
          </p>
        )}
        <Content />
        {data.tags.length > 0 && (
          <ul class="tags" aria-label={t(locale, 'post.tags')}>
            {data.tags.map((tag) => (
              <li>
                <a href={paths.tag(locale, tag)}>{tag}</a>
              </li>
            ))}
          </ul>
        )}
        <nav class="pager" aria-label={`${t(locale, 'post.prev')} / ${t(locale, 'post.next')}`} lang={locale}>
          {prev && (
            <a href={paths.post(prev)} rel="prev">
              <span class="dir">← {t(locale, 'post.prev')}</span>
              <span lang={prev.contentLocale}>{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a class="next" href={paths.post(next)} rel="next">
              <span class="dir">{t(locale, 'post.next')} →</span>
              <span lang={next.contentLocale}>{next.data.title}</span>
            </a>
          )}
        </nav>
        {data.comments && <Giscus slug={post.slug} locale={locale} theme="noborder_dark" />}
      </div>
    </div>
  </article>
</Layout>
