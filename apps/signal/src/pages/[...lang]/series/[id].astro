---
import { t, type Locale } from '@blog/core/i18n';
import type { SeriesInfo } from '@blog/core/posts';
import { seriesPaths } from '@blog/core/routes';
import Opener from '../../../components/Opener.astro';
import PostRow from '../../../components/PostRow.astro';
import Layout from '../../../layouts/Layout.astro';

export const getStaticPaths = () => seriesPaths();

const { locale, series } = Astro.props as { locale: Locale; series: SeriesInfo };
---

<Layout locale={locale} title={series.title} description={series.description}>
  <Opener title={series.title} seedKey={`series-${series.id}`} shape="knot" dek={series.description || undefined}>
    <p class="meta">
      <span class="type-chip">[{t(locale, 'nav.series')}]</span>
      <span>{t(locale, 'series.parts', { n: series.parts.length })}</span>
    </p>
  </Opener>
  <section class="wrap feed">
    <ol class="stream listing">
      {series.parts.map((post) => (
        <PostRow post={post} heading="h2" showDate />
      ))}
    </ol>
  </section>
</Layout>
