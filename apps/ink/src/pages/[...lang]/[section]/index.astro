---
import { t, type Locale } from '@blog/core/i18n';
import { getPosts, getPostsBySection, type Section } from '@blog/core/posts';
import { sectionPaths } from '@blog/core/routes';
import PostCard from '../../../components/PostCard.astro';
import Tone from '../../../components/Tone.astro';
import Layout from '../../../layouts/Layout.astro';
import { chapterNumbers } from '../../../lib/chapters';

export const getStaticPaths = () => sectionPaths();

const { locale, section } = Astro.props as { locale: Locale; section: Section };
const posts = await getPostsBySection(locale, section);
const numbers = chapterNumbers(await getPosts(locale));
const title = t(locale, section === 'posts' ? 'nav.posts' : section === 'notes' ? 'nav.notes' : 'nav.links');
const deks: Record<Section, Record<Locale, string>> = {
  posts: { vi: 'Bài dài về những dự án đang làm.', en: 'Long reads about the projects in progress.' },
  notes: { vi: 'Ghi chú ngắn mỗi khi học được điều gì đó.', en: 'Short notes whenever something new sticks.' },
  links: { vi: 'Vài đường link đáng đọc, kèm vài dòng vì sao.', en: 'Links worth reading, with a line on why.' },
};
---

<Layout locale={locale} title={title} page="list">
  <header class="page-head" data-resist>
    <h1 class="page-title">
      <Tone text={title} mode="land" intro />
    </h1>
    <p class="page-dek">{deks[section][locale]}</p>
    <p class="meta">
      <span>
        {posts.length} {locale === 'vi' ? 'mục' : posts.length === 1 ? 'entry' : 'entries'}
      </span>
    </p>
  </header>
  {posts.length ? (
    <ol class="stream">
      {posts.map((post, i) => (
        <PostCard post={post} no={numbers.get(post.slug)} seed={i + 11} />
      ))}
    </ol>
  ) : (
    <p class="empty">{t(locale, 'list.empty')}</p>
  )}
</Layout>
