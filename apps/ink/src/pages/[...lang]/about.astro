---
import { t, type Locale } from '@blog/core/i18n';
import { getPage } from '@blog/core/posts';
import { localePaths } from '@blog/core/routes';
import { render } from 'astro:content';
import Tone from '../../components/Tone.astro';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = () => localePaths();

const { locale } = Astro.props as { locale: Locale };
const page = await getPage(locale, 'about');
const rendered = page ? await render(page) : undefined;
const Content = rendered?.Content;
const title = page?.data.title ?? t(locale, 'nav.about');
const lang = page?.id.split('/')[0] ?? locale;
---

<Layout locale={locale} title={title} description={page?.data.description} page="page">
  <article class="solo">
    <header class="page-head" data-resist>
      <h1 class="page-title" lang={lang}>
        <Tone text={title} mode="land" intro />
      </h1>
      {page?.data.description && (
        <p class="page-dek" lang={lang}>
          {page.data.description}
        </p>
      )}
    </header>
    <div class="post-grid">
      <div class="prose" lang={lang} data-resist>
        {Content && <Content />}
      </div>
    </div>
  </article>
</Layout>
