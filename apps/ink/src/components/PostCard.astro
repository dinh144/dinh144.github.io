---
/** One chapter in a list: hanging № numeral, title with tone marks, dek, and a meta column. */
import { formatDate, t } from '@blog/core/i18n';
import type { Post } from '@blog/core/posts';
import { paths } from '@blog/core/routes';
import { pad2 } from '../lib/chapters';
import Icon from './Icon.astro';
import InkRule from './InkRule.astro';
import Tone from './Tone.astro';

interface Props {
  post: Post;
  no?: number;
  heading?: 'h2' | 'h3';
  seed?: number;
}
const { post, no, heading = 'h2', seed = 1 } = Astro.props;
const { data } = post;
const Heading = heading;
const host = data.type === 'link' && data.link ? new URL(data.link).hostname.replace(/^www\./, '') : undefined;
const kind =
  data.type === 'note'
    ? t(post.locale, 'type.note')
    : data.type === 'link'
      ? t(post.locale, 'type.link')
      : data.series
        ? `${t(post.locale, 'type.series')} · ${data.series.part}`
        : t(post.locale, 'type.article');
---

<li class="entry" data-type={data.type} data-series={data.series?.id} data-reveal>
  <div class="entry-no no" aria-hidden="true" data-pagefind-ignore>
    {no !== undefined && (
      <>
        <span class="sign">№</span>
        {pad2(no)}
      </>
    )}
  </div>
  <div class="entry-body" lang={post.contentLocale}>
    <Heading class="entry-title">
      <a href={paths.post(post)}>
        <Tone text={data.title} />
      </a>
    </Heading>
    {data.type !== 'note' && data.description && <p class="entry-dek">{data.description}</p>}
  </div>
  <div class="entry-side">
    <p class="meta">
      <span class="entry-type">{kind}</span>
      <time datetime={data.date.toISOString()}>{formatDate(data.date, post.locale, 'numeric')}</time>
      {data.type === 'article' && <span>{t(post.locale, 'post.minutes', { n: post.minutes })}</span>}
      {host && (
        <span class="entry-host">
          {host}
          <Icon name="external" />
        </span>
      )}
      {post.fallback && (
        <span class="hl" lang="vi" title={t(post.locale, 'post.fallback')}>
          Tiếng Việt
        </span>
      )}
    </p>
    {data.tags.length > 0 && <p class="meta entry-tags">{data.tags.map((tag) => `#${tag}`).join(' ')}</p>}
  </div>
  <InkRule seed={seed} />
</li>
